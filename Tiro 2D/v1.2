<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Enéias Game</title>
<style>
    body { margin: 0; overflow: hidden; background: #111; }
    canvas { display: block; margin: 0 auto; background: #222; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
canvas.width = 600;
canvas.height = 800;

let gameState = "menu";
let gameMode = "single";
let winner = "";

// ================= FUNDO =================
const backgroundImg = new Image();
backgroundImg.src = "Fundo.svg";

// ================= PLAYER 1 (BAIXO) =================
const player1 = {
    x: canvas.width/2 - 20,
    y: canvas.height - 80,
    width: 40,
    height: 40,
    speed: 5,
    bullets: [],
    img: new Image(),
    hp: 100,
    maxHp: 100
};
player1.img.src = "Eneias.svg";

// ================= PLAYER 2 (CIMA) =================
const player2 = {
    x: canvas.width/2 - 20,
    y: 40,
    width: 40,
    height: 40,
    speed: 5,
    bullets: [],
    img: new Image(),
    hp: 100,
    maxHp: 100
};
player2.img.src = "Eneias2.svg";

// ================= INIMIGOS =================
let enemies = [];
let enemyBullets = [];
let lastEnemySpawn = 0;
let enemySpawnInterval = 2000;
const enemyImg = new Image();
enemyImg.src = "EneiasReverso.svg";

// ================= CONTROLES =================
const keys = {};
document.addEventListener("keydown", e => {
    keys[e.key.toLowerCase()] = true;

    if (gameState === "menu") {
        if (e.key === "1") { gameMode = "single"; startGame(); }
        if (e.key === "2") { gameMode = "vs"; startGame(); }
    }

    if (gameState === "gameover" && e.key === "Enter") {
        gameState = "menu";
    }
});
document.addEventListener("keyup", e => keys[e.key.toLowerCase()] = false);

// ================= FUNÇÕES =================
function startGame() {
    resetGame();
    gameState = "playing";
}

function resetGame() {
    enemies = [];
    enemyBullets = [];
    player1.hp = 100;
    player2.hp = 100;
    player1.bullets = [];
    player2.bullets = [];
    winner = "";
}

function shoot(player, direction) {
    player.bullets.push({
        x: player.x + player.width/2 - 5,
        y: player.y + (direction === 1 ? 0 : player.height),
        width: 10,
        height: 20,
        speed: 7 * direction,
        damage: 10
    });
}

function spawnEnemy() {
    const size = 40;
    const x = Math.random() * (canvas.width - size);
    enemies.push({
        x, y: -size,
        width: size,
        height: size,
        hp: 40,
        speed: 2,
        shootCooldown: 100
    });
}

function enemyShoot(e) {
    const target = Math.random() < 0.5 ? player1 : player2;

    const dx = (target.x + target.width/2) - (e.x + e.width/2);
    const dy = (target.y + target.height/2) - (e.y + e.height/2);
    const mag = Math.sqrt(dx*dx + dy*dy);

    enemyBullets.push({
        x: e.x + e.width/2,
        y: e.y + e.height/2,
        dx: (dx/mag) * 4,
        dy: (dy/mag) * 4,
        size: 8,
        damage: 10
    });
}

// ================= UPDATE =================
function update() {
    if (gameState !== "playing") return;

    // MOVIMENTO P1
    if (keys["a"] && player1.x > 0) player1.x -= player1.speed;
    if (keys["d"] && player1.x + player1.width < canvas.width) player1.x += player1.speed;
    if (keys["w"] && player1.y > canvas.height/2) player1.y -= player1.speed;
    if (keys["s"] && player1.y + player1.height < canvas.height) player1.y += player1.speed;

    // MOVIMENTO P2
    if (gameMode === "vs") {
        if (keys["arrowleft"] && player2.x > 0) player2.x -= player2.speed;
        if (keys["arrowright"] && player2.x + player2.width < canvas.width) player2.x += player2.speed;
        if (keys["arrowup"] && player2.y > 0) player2.y -= player2.speed;
        if (keys["arrowdown"] && player2.y + player2.height < canvas.height/2)
            player2.y += player2.speed;
    }

    // TIROS
    if (keys[" "] && !keys.cool1) {
        shoot(player1, -1);
        keys.cool1 = 15;
    }

    if (gameMode === "vs" && keys["shift"] && !keys.cool2) {
        shoot(player2, 1);
        keys.cool2 = 15;
    }

    if (keys.cool1) keys.cool1--;
    if (keys.cool2) keys.cool2--;

    // ATUALIZA BALAS P1
    player1.bullets.forEach((b,i)=>{
        b.y += b.speed;

        if (gameMode === "vs") {
            if (collision(b, player2)) {
                player2.hp -= b.damage;
                player1.bullets.splice(i,1);
            }
        }

        enemies.forEach((e,j)=>{
            if (collision(b,e)){
                e.hp -= b.damage;
                player1.bullets.splice(i,1);
            }
        });
    });

    // ATUALIZA BALAS P2
    player2.bullets.forEach((b,i)=>{
        b.y += b.speed;

        if (collision(b, player1)) {
            player1.hp -= b.damage;
            player2.bullets.splice(i,1);
        }
    });

    // SPAWN INIMIGOS
    if (Date.now() - lastEnemySpawn > enemySpawnInterval && gameMode==="single") {
        spawnEnemy();
        lastEnemySpawn = Date.now();
    }

    // ATUALIZA INIMIGOS
    enemies.forEach((e,i)=>{
        e.y += e.speed;

        if (!e.shootCooldown) {
            enemyShoot(e);
            e.shootCooldown = 120;
        } else e.shootCooldown--;

        if (e.hp <= 0 || e.y > canvas.height)
            enemies.splice(i,1);
    });

    // BALAS INIMIGAS
    enemyBullets.forEach((b,i)=>{
        b.x += b.dx;
        b.y += b.dy;

        if (collision(b, player1)) {
            player1.hp -= b.damage;
            enemyBullets.splice(i,1);
        }
        if (collision(b, player2)) {
            player2.hp -= b.damage;
            enemyBullets.splice(i,1);
        }
    });

    // MORTE
    if (gameMode === "single" && player1.hp <= 0) {
        winner = "GAME OVER";
        gameState = "gameover";
    }

    if (gameMode === "vs") {
        if (player1.hp <= 0) {
            winner = "PLAYER 2 VENCEU!";
            gameState = "gameover";
        }
        if (player2.hp <= 0) {
            winner = "PLAYER 1 VENCEU!";
            gameState = "gameover";
        }
    }
}

function collision(a,b){
    return a.x < b.x + b.width &&
           a.x + (a.width||a.size) > b.x &&
           a.y < b.y + b.height &&
           a.y + (a.height||a.size) > b.y;
}

// ================= DRAW =================
function drawHealthBar(p){
    ctx.fillStyle="red";
    ctx.fillRect(p.x,p.y-10,p.width,5);
    ctx.fillStyle="lime";
    ctx.fillRect(p.x,p.y-10,p.width*(p.hp/p.maxHp),5);
}

function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    if(backgroundImg.complete)
        ctx.drawImage(backgroundImg,0,0,canvas.width,canvas.height);

    if(gameState==="menu"){
        ctx.fillStyle="white";
        ctx.font="40px Arial";
        ctx.textAlign="center";
        ctx.fillText("ENÉIAS GAME",canvas.width/2,250);
        ctx.font="22px Arial";
        ctx.fillText("1 - Single Player",canvas.width/2,350);
        ctx.fillText("2 - Multiplayer VS",canvas.width/2,390);
        return;
    }

    if(gameState==="gameover"){
        ctx.fillStyle="red";
        ctx.font="40px Arial";
        ctx.fillText(winner,canvas.width/2,350);
        ctx.font="20px Arial";
        ctx.fillText("ENTER para voltar",canvas.width/2,400);
        return;
    }

    ctx.drawImage(player1.img,player1.x,player1.y,40,40);
    drawHealthBar(player1);

    if(gameMode==="vs"){
        ctx.drawImage(player2.img,player2.x,player2.y,40,40);
        drawHealthBar(player2);
    }

    ctx.fillStyle="yellow";
    player1.bullets.forEach(b=>ctx.fillRect(b.x,b.y,b.width,b.height));
    player2.bullets.forEach(b=>ctx.fillRect(b.x,b.y,b.width,b.height));

    ctx.fillStyle="orange";
    enemyBullets.forEach(b=>ctx.fillRect(b.x,b.y,b.size,b.size));

    enemies.forEach(e=>{
        ctx.drawImage(enemyImg,e.x,e.y,e.width,e.height);
    });
}

function gameLoop(){
    update();
    draw();
    requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);
</script>

</body>
</html>
